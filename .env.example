NEXT_PUBLIC_APP_URL=http://localhost:3000

# Botón flotante WhatsApp (abajo derecha, compras). Por defecto en código: 51986964194; aquí puedes anular.
# NEXT_PUBLIC_WHATSAPP_URL=https://wa.me/51986964194?text=Hola
# NEXT_PUBLIC_WHATSAPP_PHONE=51986964194
# NEXT_PUBLIC_WHATSAPP_MESSAGE=Hola, quiero comprar en RRBOXING.

# Clase grabada de regalo post-compra (YouTube: enlace watch o youtu.be)
# NEXT_PUBLIC_POST_PURCHASE_VIDEO_URL=https://www.youtube.com/watch?v=XXXXXXXX

# Pago en línea de los pedidos (Mercado Pago, Checkout Pro). Sin el token, el pago se coordina por WhatsApp.
# MERCADOPAGO_ACCESS_TOKEN=
# Opcional: clave secreta de los Webhooks de Mercado Pago, para revisar la firma de cada aviso de pago.
# MERCADOPAGO_WEBHOOK_SECRET=
# La lista completa de variables, con para qué sirve cada una, está en el panel: /admin/settings.
# Opcional: clave para firmar la sesión de admin (32+ caracteres al azar).
# Si no está, se deriva de SUPABASE_SERVICE_ROLE_KEY. Nunca uses un texto fijo.
# AUTH_SECRET=
